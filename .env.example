# .env.example — Local development environment variables
# Copy to .env.local and fill in your values.
#
# PRODUCTION NOTE:
# In Firebase App Hosting, these are NOT needed. Environment variables are
# defined in apphosting.yaml, and secrets in Cloud Secret Manager.
# The Admin SDK uses Application Default Credentials (ADC) automatically.

# ── Client Firebase Config ─────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-vapid-key"

# ── Admin SDK (Local Dev Only) ─────────────────────────────────────
# NOT needed in production — App Hosting uses ADC automatically.
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"

# ── Emulator Config (Local Dev Only) ──────────────────────────────
NEXT_PUBLIC_USE_EMULATORS=true
FIREBASE_AUTH_EMULATOR_HOST="localhost:9099"
FIRESTORE_EMULATOR_HOST="localhost:8080"
FIREBASE_STORAGE_EMULATOR_HOST="localhost:9199"

# ── Application Config ────────────────────────────────────────────
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN="moe-dl.edu.my"
NEXT_PUBLIC_APP_NAME="QBike"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── External APIs ─────────────────────────────────────────────────
NEXT_PUBLIC_GEMINI_API_KEY=
SENDGRID_API_KEY=

# ── Feature Flags ─────────────────────────────────────────────────
ENABLE_EMAIL_NOTIFICATIONS=false
