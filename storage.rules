rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /verification-uploads/{fileName} {
      // Admin SDK handles all uploads server-side; no client writes permitted.
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Return photos — mandatory on bike return (max 1 MB, images only)
    match /return-photos/{userId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
    }

    // Issue photos — optional, attached to condition reports (max 1 MB, images only)
    match /issue-photos/{userId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
    }

    // Catch-all: deny all other paths explicitly.
    // This ensures any future path additions are secure by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}